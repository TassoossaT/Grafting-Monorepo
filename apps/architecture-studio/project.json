{
  "name": "architecture-studio",
  "root": "apps/architecture-studio",
  "projectType": "application",
  "tags": ["scope:knowledge", "lang:typescript", "platform:web", "type:app"],
  "implicitDependencies": ["generation-wasm", "isekai-wasm-bridge", "three-canvas", "ui", "x6-canvas"],
  "metadata": {
    "graphIr": {
      "id": "architecture-studio",
      "kind": "app",
      "tags": ["scope:knowledge", "lang:typescript", "platform:web"]
    }
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio check" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/docs/generated/grafting.graph.json", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio dev" },
      "dependsOn": ["generation-wasm:build", "isekai-wasm-bridge:build", "three-canvas:build", "ui:build", "x6-canvas:build"],
      "cache": false
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio build" },
      "dependsOn": ["generation-wasm:build", "isekai-wasm-bridge:build", "three-canvas:build", "ui:build", "x6-canvas:build"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/docs/generated/grafting.graph.json", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/.next"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio test" },
      "dependsOn": ["three-canvas:build", "ui:build", "x6-canvas:build"],
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/test/**/*", "{projectRoot}/package.json", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "stories-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/generate-stories.mjs" },
      "dependsOn": ["ui:docs-mesh-export"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docs/generated/meshes/ui-doc-mesh.v1.json",
        "{projectRoot}/scripts/generate-stories.mjs"
      ],
      "outputs": ["{projectRoot}/stories"]
    },
    "stories-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node scripts/generate-stories.mjs --check" },
      "dependsOn": ["ui:docs-mesh-export"],
      "cache": true,
      "inputs": [
        "{workspaceRoot}/docs/generated/meshes/ui-doc-mesh.v1.json",
        "{projectRoot}/scripts/generate-stories.mjs",
        "{projectRoot}/stories/**/*"
      ]
    },
    "storybook": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio storybook" },
      "dependsOn": ["stories-generate"],
      "cache": false
    },
    "build-storybook": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/architecture-studio build-storybook" },
      "dependsOn": ["stories-generate"],
      "cache": true,
      "inputs": ["{projectRoot}/.storybook/**/*", "{projectRoot}/stories/**/*", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/storybook-static"]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-api-docs.mjs architecture-studio" },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-api-docs.mjs architecture-studio --check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/project.json",
        "{workspaceRoot}/docs/generated/api/ts/architecture-studio.api.md",
        "{workspaceRoot}/tools/scripts/generate-api-docs.mjs",
        "sharedGlobals"
      ]
    }
  }
}
