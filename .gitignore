.pnpm-store/
.worktrees/
.next/
.nx/
.venv/
.pytest_cache/
dist/
__pycache__/
*.egg-info/

# Claude Code project-local permissions remain machine-specific. The shared
# .claude/settings.json contains only the repository task-ownership hook.
.claude/settings.local.json

# Rust build outputs
target/

# C#/.NET build and test outputs. Scoped to dotnet/ specifically -- a bare
# `bin/`/`obj/` also matches Rust's own `src/bin/` convention for extra
# Cargo binary targets (e.g. libs/graph/core/src/bin/,
# libs/isekai/capi-bridge/src/bin/), which is real source code, not build
# output, and must stay tracked. Found by CI failing to build a bin target
# that had silently never been committed.
dotnet/**/bin/
dotnet/**/obj/
artifacts/
TestResults/

#spikes for tests
spikes/

# Storybook build output (apps/architecture-studio)
storybook-static/

# FlatBuffers generated output (master source S10.3: not the source of
# truth, regenerated via `pnpm exec nx run engine-domain-core:generate`).
# The *fixture* generated code under domain-core/tests/generated_v1/ is
# deliberately NOT covered by this rule -- see docs/adr/ADR-0009.
libs/engine/domain-core/src/generated/
packages/isekai-web-client/src/generated/
dotnet/Grafting.Isekai.Protocol/Generated/

# Cached, version-matched flatc used only for C# generation (see
# tools/scripts/get-flatc-csharp.ps1) -- downloaded on demand, not the
# primary pinned flatc (tools/flatc-version.txt).
tools/.flatc-csharp/

# TypeScript incremental build info
*.tsbuildinfo

# Downloaded binaries and versioned tool folders
packages/cloudflared.exe
22.23.2/

