{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafting.local/schemas/ai-capability-v1.json",
  "title": "Grafting control-plane capability",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "summary", "command", "risk", "side_effects", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]+$" },
    "summary": { "type": "string", "minLength": 1 },
    "command": { "type": "string", "minLength": 1 },
    "risk": { "enum": ["low", "medium", "high"] },
    "side_effects": { "type": "boolean" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
  }
}
