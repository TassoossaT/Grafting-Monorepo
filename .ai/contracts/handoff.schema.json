{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grafting.local/schemas/ai-handoff-v1.json",
  "title": "Grafting multi-agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "handoff_id", "created_at", "task_id", "sender",
    "recipient", "objective", "context", "criteria", "constraints",
    "uncertainties", "artifacts", "current_owner", "return_schema",
    "next_responsible_party"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "handoff_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "task_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{2,63}$" },
    "sender": { "type": "string", "minLength": 1 },
    "recipient": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "context": { "type": "array", "items": { "type": "string" } },
    "criteria": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "current_owner": { "type": ["string", "null"] },
    "return_schema": { "type": "string", "minLength": 1 },
    "next_responsible_party": { "type": "string", "minLength": 1 }
  }
}
