{
  "name": "isekai-wasm-bridge",
  "root": "libs/isekai/wasm-bridge",
  "projectType": "library",
  "tags": ["scope:engine", "lang:rust", "platform:web", "type:binding"],
  "implicitDependencies": ["engine-domain-core", "graph-core"],
  "metadata": {
    "graphIr": {
      "_comment": "Placeholder only -- no Graph IR v1 schema exists yet. Superseded once a real Graph IR extractor lands (DEC-028).",
      "id": "isekai-wasm-bridge",
      "kind": "binding",
      "tags": ["scope:engine", "lang:rust", "platform:web"]
    }
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p grafting-isekai-wasm"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p grafting-isekai-wasm && wasm-pack test --node libs/isekai/wasm-bridge"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-isekai-wasm" },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-isekai-wasm --check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/tools/rust-public-api-toolchain.txt",
        "{workspaceRoot}/docs/generated/api/rust/grafting-isekai-wasm.md",
        "{workspaceRoot}/tools/scripts/generate-rust-api-docs.mjs",
        "{workspaceRoot}/tools/rust-api-docgen/src/main.rs",
        "sharedGlobals"
      ]
    }
  }
}
