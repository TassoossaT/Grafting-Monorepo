{
  "name": "graph-core",
  "root": "libs/graph/core",
  "projectType": "library",
  "tags": ["scope:shared", "lang:rust", "platform:cross", "type:lib"],
  "metadata": {
    "graphIr": {
      "id": "graph-core",
      "kind": "lib",
      "tags": ["scope:shared", "lang:rust", "platform:cross"]
    }
  },
  "targets": {
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo fmt -p grafting-graph-core -- --check"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/rust-toolchain.toml"]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p grafting-graph-core --all-targets --all-features"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo clippy -p grafting-graph-core --all-targets --all-features -- -D warnings"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p grafting-graph-core --all-features"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/docs/graph-ir/fixtures/**/*"
      ]
    },
    "api-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test --locked -p grafting-graph-core --test public_api_snapshot -- --ignored --exact generated_public_api_matches_snapshot && cargo test --locked -p grafting-graph-core --test public_api_snapshot -- --exact baseline_comparison_rejects_drift && cargo test --locked -p grafting-graph-core --test public_api_contract"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/lib.rs",
        "{projectRoot}/src/contour.rs",
        "{projectRoot}/src/layout.rs",
        "{projectRoot}/src/model.rs",
        "{projectRoot}/src/surface.rs",
        "{projectRoot}/src/transformation_plan.rs",
        "{projectRoot}/tests/public_api_contract.rs",
        "{projectRoot}/tests/public_api_snapshot.rs",
        "{projectRoot}/tests/snapshots/public-api.txt",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml",
        "{workspaceRoot}/tools/rust-public-api-toolchain.txt"
      ]
    },
    "graph-ir-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo run -p grafting-graph-core --features graph-ir-cli --bin validate-graph-ir -- docs/graph-ir/fixtures/valid-minimal.graph.json"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/docs/graph-ir/fixtures/valid-minimal.graph.json"
      ]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-graph-core" },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-graph-core --check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/tools/rust-public-api-toolchain.txt",
        "{workspaceRoot}/docs/generated/api/rust/grafting-graph-core.md",
        "{workspaceRoot}/tools/scripts/generate-rust-api-docs.mjs",
        "{workspaceRoot}/tools/rust-api-docgen/src/main.rs",
        "sharedGlobals"
      ]
    }
  }
}
