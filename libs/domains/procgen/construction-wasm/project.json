{
  "name": "construction-wasm",
  "root": "libs/domains/procgen/construction-wasm",
  "projectType": "library",
  "tags": [
    "scope:procgen",
    "lang:rust",
    "platform:web",
    "type:lib"
  ],
  "metadata": {
    "graphIr": {
      "id": "construction-wasm",
      "kind": "lib",
      "tags": [
        "scope:procgen",
        "lang:rust",
        "platform:web",
        "type:lib"
      ]
    }
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "wasm-pack build --target web --out-dir pkg", "cwd": "libs/domains/procgen/construction-wasm" },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/Cargo.toml", "{projectRoot}/package.json", "^default", "{workspaceRoot}/Cargo.toml", "{workspaceRoot}/Cargo.lock", "{workspaceRoot}/rust-toolchain.toml"],
      "outputs": ["{projectRoot}/pkg"]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p grafting-procgen-construction-wasm"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p grafting-procgen-construction-wasm && wasm-pack test --node libs/domains/procgen/construction-wasm"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-procgen-construction-wasm"
      },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-procgen-construction-wasm --check"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/tools/rust-public-api-toolchain.txt",
        "{workspaceRoot}/docs/generated/api/rust/grafting-procgen-construction-wasm.md",
        "{workspaceRoot}/tools/scripts/generate-rust-api-docs.mjs",
        "{workspaceRoot}/tools/rust-api-docgen/src/main.rs",
        "sharedGlobals"
      ]
    }
  }
}
