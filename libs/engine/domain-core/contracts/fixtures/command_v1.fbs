namespace Grafting.Contracts;

table Increment {
  amount: int64 (id: 0);
}

table Decrement {
  amount: int64 (id: 0);
}

table Reset {}

table RollAndAdd {
  min: int64 (id: 0);
  max: int64 (id: 1);
}

union CommandPayload {
  Increment,
  Decrement,
  Reset,
  RollAndAdd,
}

table CommandMessage {
  payload: CommandPayload (id: 1);
}

root_type CommandMessage;
