{
  "name": "engine-domain-core",
  "root": "libs/engine/domain-core",
  "projectType": "library",
  "tags": ["scope:engine", "lang:rust", "platform:cross", "type:lib"],
  "metadata": {
    "graphIr": {
      "_comment": "Placeholder only -- no Graph IR v1 schema exists yet (DEC-040/spike 7, not started). Superseded once a real Graph IR extractor lands; this satisfies DEC-028's 'every Nx project is born with ... Graph IR metadata' without inventing a fake schema.",
      "id": "engine-domain-core",
      "kind": "lib",
      "tags": ["scope:engine", "lang:rust", "platform:cross"]
    }
  },
  "targets": {
    "generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/scripts/generate-contracts.mjs"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/contracts/*.fbs",
        "{workspaceRoot}/tools/flatc-version.txt",
        "{workspaceRoot}/tools/scripts/generate-contracts.mjs",
        "{workspaceRoot}/tools/scripts/generate-contracts.ps1",
        "{workspaceRoot}/tools/scripts/get-flatc-csharp.ps1"
      ],
      "outputs": [
        "{projectRoot}/src/generated",
        "{workspaceRoot}/packages/isekai-web-client/src/generated",
        "{workspaceRoot}/dotnet/Grafting.Isekai.Protocol/Generated"
      ]
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo check -p grafting-domain-core"
      },
      "dependsOn": ["generate"],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cargo test -p grafting-domain-core"
      },
      "dependsOn": ["generate"],
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.lock",
        "{workspaceRoot}/rust-toolchain.toml"
      ]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-domain-core" },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-rust-api-docs.mjs grafting-domain-core --check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/Cargo.toml",
        "{workspaceRoot}/Cargo.toml",
        "{workspaceRoot}/tools/rust-public-api-toolchain.txt",
        "{workspaceRoot}/docs/generated/api/rust/grafting-domain-core.md",
        "{workspaceRoot}/tools/scripts/generate-rust-api-docs.mjs",
        "{workspaceRoot}/tools/rust-api-docgen/src/main.rs",
        "sharedGlobals"
      ]
    }
  }
}
