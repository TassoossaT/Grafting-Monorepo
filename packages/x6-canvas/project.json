{
  "name": "x6-canvas",
  "root": "packages/x6-canvas",
  "projectType": "library",
  "tags": ["scope:shared", "lang:typescript", "platform:web", "type:ui-adapter"],
  "metadata": {
    "graphIr": {
      "id": "x6-canvas",
      "kind": "lib",
      "tags": ["scope:shared", "lang:typescript", "platform:web"]
    },
    "publicApi": {
      "entryPoint": "src/index.ts",
      "baseline": "tests/snapshots/public-api.md",
      "forbiddenModules": ["@antv/x6"]
    }
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/x6-canvas check" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/x6-canvas build" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/x6-canvas test" },
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*", "{projectRoot}/test/**/*", "{projectRoot}/package.json", "{projectRoot}/tsconfig.json", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/dist"]
    },
    "api-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node --test tools/scripts/check-typescript-public-api.test.mjs && pnpm --filter @grafting/x6-canvas api-check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/project.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tests/snapshots/public-api.md",
        "{workspaceRoot}/tools/scripts/check-typescript-public-api.mjs",
        "{workspaceRoot}/tools/scripts/check-typescript-public-api.test.mjs",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    }
  }
}
