{
  "name": "x6-canvas",
  "root": "packages/x6-canvas",
  "projectType": "library",
  "tags": ["scope:shared", "lang:typescript", "platform:web", "type:ui-adapter", "lifecycle:retired"],
  "metadata": {
    "graphIr": {
      "id": "x6-canvas",
      "kind": "lib",
      "tags": ["scope:shared", "lang:typescript", "platform:web", "lifecycle:retired"]
