{
  "name": "graph-x6",
  "root": "packages/graph-x6",
  "projectType": "library",
  "tags": ["scope:knowledge", "lang:typescript", "platform:web", "type:visualization"],
  "implicitDependencies": ["x6-canvas"],
  "metadata": {
    "graphIr": {
      "id": "graph-x6",
      "kind": "lib",
      "tags": ["scope:knowledge", "lang:typescript", "platform:web"]
    }
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/graph-x6 check" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/graph-x6 build" },
      "dependsOn": ["x6-canvas:build"],
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": ["{projectRoot}/dist"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/graph-x6 test" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"]
    }
  }
}
