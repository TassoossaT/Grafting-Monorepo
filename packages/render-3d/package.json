{
  "name": "@grafting/render-3d",
  "version": "0.0.0",
  "private": true,
  "description": "Generic 3D rendering engine: one graphics context, a caller-named scene, externally registered visual kinds, and simulated time that can be paused or stepped.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "api-check": "node ../../tools/scripts/check-typescript-public-api.mjs ."
  },
  "dependencies": {
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/three": "0.182.0",
    "typescript": "5.9.3"
  }
}
