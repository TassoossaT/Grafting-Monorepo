{
  "name": "ui",
  "root": "packages/ui",
  "projectType": "library",
  "tags": ["scope:shared", "lang:typescript", "platform:web", "type:ui"],
  "metadata": {
    "graphIr": {
      "id": "ui",
      "kind": "lib",
      "tags": ["scope:shared", "lang:typescript", "platform:web", "type:ui"]
    },
    "publicApi": {
      "entryPoint": "src/index.ts",
      "baseline": "tests/snapshots/public-api.md",
      "forbiddenModules": ["antd", "react-dom", "react-grid-layout"]
    }
  },
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/ui check" },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @grafting/ui build && node packages/ui/scripts/export-doc-mesh.mjs"
      },
      "cache": true,
      "inputs": ["{projectRoot}/**/*", "{workspaceRoot}/pnpm-lock.yaml"],
      "outputs": [
        "{projectRoot}/dist",
        "{workspaceRoot}/docs/generated/meshes/ui-doc-mesh.v1.json"
      ]
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/ui watch" },
      "continuous": true,
      "cache": false
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm --filter @grafting/ui test" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/tests/**/*.test.mjs",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig.json",
        "{workspaceRoot}/pnpm-lock.yaml"
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "api-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/scripts/check-typescript-public-api.test.mjs && pnpm --filter @grafting/ui api-check"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/project.json",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/tests/snapshots/public-api.md",
        "{workspaceRoot}/tools/scripts/check-typescript-public-api.mjs",
        "{workspaceRoot}/tools/scripts/check-typescript-public-api.test.mjs",
        "{workspaceRoot}/pnpm-lock.yaml"
      ]
    },
    "docs-generate": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-api-docs.mjs ui" },
      "cache": false
    },
    "docs-check": {
      "executor": "nx:run-commands",
      "options": { "command": "node tools/scripts/generate-api-docs.mjs ui --check" },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/project.json",
        "{workspaceRoot}/docs/generated/api/ts/ui.api.md",
        "{workspaceRoot}/tools/scripts/generate-api-docs.mjs",
        "sharedGlobals"
      ]
    },
    "docs-mesh-export": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node packages/ui/scripts/export-doc-mesh.mjs"
      },
      "cache": true,
      "inputs": [
        "{projectRoot}/src/index.ts",
        "{projectRoot}/scripts/export-doc-mesh.mjs",
        "{projectRoot}/project.json"
      ],
      "outputs": [
        "{workspaceRoot}/docs/generated/meshes/ui-doc-mesh.v1.json"
      ]
    }
  }
}
