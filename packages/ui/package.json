{
  "name": "@grafting/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "api-check": "node ../../tools/scripts/check-typescript-public-api.mjs ."
  },
  "dependencies": {
    "antd": "6.5.2",
    "react-grid-layout": "2.2.3",
    "rete": "2.0.6",
    "rete-area-plugin": "2.3.2",
    "rete-react-plugin": "2.1.2",
    "rete-render-utils": "2.0.3",
    "styled-components": "6.1.19",
    "three": "0.182.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.182.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3"
  }
}
