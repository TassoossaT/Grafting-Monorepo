{
  "schemaVersion": "ui-doc-mesh-meta/v1",
  "components": {
    "Text": {
      "id": "atom.text",
      "layer": "atom",
      "summary": "Bounded text with semantic tone and optional truncation.",
      "status": "stable",
      "examples": [
        {
          "id": "text-default",
          "title": "Default text",
          "snippet": "<Text content=\"Example label\" />"
        }
      ]
    },
    "StatusBadge": {
      "id": "atom.status-badge",
      "layer": "atom",
      "summary": "Semantic status marker with Grafting-owned status names.",
      "status": "stable",
      "examples": [
        {
          "id": "status-ready",
          "title": "Ready status",
          "snippet": "<StatusBadge status=\"success\" label=\"Ready\" />"
        }
      ]
    },
    "Button": {
      "id": "atom.button",
      "layer": "atom",
      "summary": "Compact action button for lightweight command triggers.",
      "status": "stable",
      "examples": [
        {
          "id": "button-default",
          "title": "Default button",
          "snippet": "<Button label=\"Run\" />"
        }
      ]
    },
    "Card": {
      "id": "atom.card",
      "layer": "atom",
      "summary": "Dependency-free bounded surface with replaceable accent and selection styles.",
      "status": "stable",
      "examples": [
        {
          "id": "card-basic",
          "title": "Basic card",
          "snippet": "<Card ariaLabel=\"Task status\">Body</Card>"
        }
      ]
    },
    "EntitySummary": {
      "id": "molecule.entity-summary",
      "layer": "molecule",
      "summary": "Composable identity card built from Card, Text, and StatusBadge.",
      "status": "stable",
      "examples": [
        {
          "id": "entity-summary-default",
          "title": "Entity card",
          "snippet": "<EntitySummary title=\"architecture-studio\" description=\"project\" />"
        }
      ]
    },
    "DataTable": {
      "id": "organism.data-table",
      "layer": "organism",
      "summary": "Immutable rows table with controlled selection and custom renderers.",
      "status": "stable",
      "examples": [
        {
          "id": "table-repo-nodes",
          "title": "Repository nodes table",
          "snippet": "<DataTable ariaLabel=\"Repository nodes\" rows={rows} rowKey={(row) => row.id} columns={columns} />"
        }
      ]
    },
    "GridLayout": {
      "id": "atom.grid-layout",
      "layer": "atom",
      "summary": "Draggable/resizable dashboard layout using Grafting-owned panel contracts.",
      "status": "stable",
      "examples": [
        {
          "id": "grid-dashboard",
          "title": "Dashboard grid",
          "snippet": "<GridLayout ariaLabel=\"Studio dashboard\" panels={panels} />"
        }
      ]
    }
  }
}
